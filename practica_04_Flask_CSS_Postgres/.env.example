# Copia este archivo y renómbralo a .env
# Rellena los datos según tu PostgreSQL local o tu base de datos en la nube

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=practica_04

# Solo se usa cuando te conectas a una base de datos en la nube que requiere SSL
# (por ejemplo Aiven). Déjalo vacío para PostgreSQL local.
POSTGRES_SSL_CA=
