# Copia este archivo y renómbralo a .env
# Rellena los datos según tu MySQL local (XAMPP) o tu base de datos en la nube

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=practica_03

# Solo se usa cuando te conectas a una base de datos en la nube que requiere SSL
# (por ejemplo Aiven). Déjalo vacío para MySQL local.
MYSQL_SSL_CA=
